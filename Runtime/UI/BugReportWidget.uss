/* BetaHub bug report widget. Sizes are px at a 1280x720 reference; PanelSettings scales the panel.
   USS has no flex gap, text-transform or box-shadow, so spacing is margins and labels are uppercase text.
   Theme = the --bh-* variables. Override them from your own stylesheet to reskin. */

.bh-theme-dark {
  --bh-ground: rgba(28, 33, 49, 0.94);
  --bh-surface: #262c3f;
  --bh-line: #3a4157;
  --bh-text: #eceae3;
  --bh-muted: #9aa0b4;
  --bh-accent: #ff7a59;
  --bh-on-accent: #1a0e0a;
  --bh-ok: #5bc489;
  --bh-warn: #e9b949;
  --bh-err: #e5484d;
  --bh-radius: 10px;
}
.bh-theme-light {
  --bh-ground: rgba(251, 251, 252, 0.95);
  --bh-surface: #eef0f4;
  --bh-line: #d6d9e2;
  --bh-text: #1b1f2e;
  --bh-muted: #5e6478;
  --bh-accent: #e0603f;
  --bh-on-accent: #ffffff;
  --bh-ok: #2f9e5e;
  --bh-warn: #b98300;
  --bh-err: #cf3b41;
  --bh-radius: 10px;
}

.bh-hidden { display: none; }

.bh-overlay {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: rgba(6, 8, 14, 0.45);
  align-items: center;
  justify-content: center;
}

.bh-widget {
  -unity-font-definition: url("Fonts/Inter-Regular.ttf");
  width: 520px;
  background-color: var(--bh-ground);
  border-width: 1px;
  border-color: var(--bh-line);
  border-radius: 14px;
  color: var(--bh-text);
  font-size: 16px;
}
.bh-widget--error { border-color: var(--bh-err); }
.bh-widget--warning { border-color: var(--bh-warn); }

/* neutralize runtime theme defaults so the preview and Unity start from the same zero.
   Bare type selectors on purpose: lowest specificity, so any .bh-* class wins. The stylesheet
   is scoped to this UXML tree, so nothing outside the widget is affected. */
Label { margin: 0; padding: 0; color: var(--bh-text); white-space: normal; }
Button { margin: 0; padding: 0; border-width: 0; background-color: transparent; color: var(--bh-text); }
TextField { margin: 0; padding: 0; }
#unity-text-input { margin: 0; padding: 0; border-width: 1px; }
Toggle { margin: 0; padding: 0; }

/* bold face: a real font file rather than synthesized bold, so browser and Unity agree */
.bh-bold { -unity-font-definition: url("Fonts/Inter-Bold.ttf"); }

/* keyboard and gamepad focus ring, shared by every focusable element */
.bh-card:focus, .bh-btn:focus, .bh-close:focus, .bh-toggle:focus { border-color: var(--bh-accent); }
.bh-field > #unity-text-input:focus { border-color: var(--bh-accent); }

/* header */
.bh-head { flex-direction: row; align-items: center; justify-content: space-between; padding: 18px 22px 10px 22px; }
.bh-head__text { flex-grow: 1; flex-shrink: 1; }
.bh-title { font-size: 22px; }
.bh-title--error { color: var(--bh-err); }
.bh-title--warning { color: var(--bh-warn); }
.bh-subtitle { font-size: 13px; color: var(--bh-muted); margin-top: 2px; }
.bh-subtitle--error { color: var(--bh-err); }
.bh-subtitle--warning { color: var(--bh-warn); }
.bh-close { width: 32px; height: 32px; border-radius: 6px; border-width: 1px; border-color: transparent; font-size: 20px; color: var(--bh-muted); -unity-text-align: middle-center; }
.bh-close:hover { background-color: var(--bh-surface); color: var(--bh-text); }

/* body */
.bh-body { padding: 0 22px 18px 22px; }
.bh-group { margin-bottom: 14px; }
.bh-group--last { margin-bottom: 0; }
.bh-label-row { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 7px; }
.bh-label { font-size: 12px; letter-spacing: 1px; color: var(--bh-muted); }
.bh-label-opt { font-size: 12px; color: var(--bh-muted); }
.bh-count { font-size: 12px; color: var(--bh-muted); }
.bh-count--over { color: var(--bh-err); }
.bh-note { font-size: 13px; color: var(--bh-muted); }
.bh-error-line { font-size: 12.5px; color: var(--bh-err); margin-top: 6px; }

.bh-field > #unity-text-input {
  background-color: var(--bh-surface);
  border-color: var(--bh-line);
  border-radius: var(--bh-radius);
  padding: 10px 12px;
  color: var(--bh-text);
  font-size: 16px;
  white-space: normal;
}
.bh-field--desc > #unity-text-input { min-height: 84px; }
.bh-field--steps > #unity-text-input { min-height: 84px; }
/* placeholder: a label laid over the empty field, hidden as soon as there is text */
.bh-placeholder { position: absolute; left: 13px; top: 11px; right: 13px; font-size: 16px; color: var(--bh-muted); opacity: 0.85; }

/* attachment cards */
.bh-cards { flex-direction: row; }
.bh-card {
  flex-grow: 1; flex-basis: 0; flex-shrink: 1;
  margin-right: 9px;
  padding: 9px;
  background-color: var(--bh-surface);
  border-width: 1px; border-color: var(--bh-line);
  border-radius: var(--bh-radius);
}
.bh-card--last { margin-right: 0; }
.bh-card:hover { border-color: var(--bh-muted); }
.bh-card--off .bh-card__preview, .bh-card--off .bh-card__meta { opacity: 0.45; }
.bh-card__box {
  position: absolute; top: 8px; right: 8px;
  width: 17px; height: 17px; border-radius: 4px;
  border-width: 1.5px; border-color: var(--bh-muted);
  align-items: center; justify-content: center;
}
.bh-card--on .bh-card__box { background-color: var(--bh-accent); border-color: var(--bh-accent); }
.bh-card__tick { width: 8px; height: 5px; border-left-width: 2px; border-bottom-width: 2px; border-color: var(--bh-on-accent); rotate: -45deg; translate: 0 -1px; display: none; }
.bh-card--on .bh-card__tick { display: flex; }
.bh-card__name { font-size: 14px; margin-right: 22px; margin-bottom: 7px; }
.bh-card__preview { height: 52px; border-radius: 7px; overflow: hidden; background-color: var(--bh-line); }
.bh-card__preview--shot { -unity-background-scale-mode: scale-and-crop; }
.bh-card__meta { font-size: 11.5px; color: var(--bh-muted); margin-top: 7px; }
.bh-card__meta--failed { color: var(--bh-warn); }

/* screenshot thumbnail placeholder; the real one is the captured PNG as background-image */
.bh-shot__sky { flex-grow: 1; background-color: #24304a; }
.bh-shot__ground { height: 55%; background-color: #0e2b23; }
.bh-shot__player { position: absolute; left: 47%; bottom: 22%; width: 6%; height: 34%; background-color: #3f7fbf; border-top-left-radius: 3px; border-top-right-radius: 3px; }
.bh-shot__enemy { position: absolute; right: 16%; bottom: 20%; width: 8%; height: 26%; background-color: #e35d5d; border-top-left-radius: 6px; border-top-right-radius: 6px; }

.bh-card__preview--clip { flex-direction: row; align-items: flex-end; padding: 6px 6px; background-color: #171b29; }
.bh-bar { flex-grow: 1; margin-right: 2px; background-color: var(--bh-accent); opacity: 0.85; border-radius: 1px; }
.bh-clip__play { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-text-align: middle-center; font-size: 18px; color: #ffffff; }

.bh-card__preview--log { padding: 5px 7px; }
.bh-log__text { font-size: 9px; color: var(--bh-muted); white-space: nowrap; }

/* optional terms line */
.bh-terms { flex-direction: row; align-items: center; margin-top: 12px; }
.bh-terms__text { font-size: 13px; color: var(--bh-muted); margin-left: 8px; }
.bh-toggle { width: 17px; height: 17px; }
.bh-toggle > .unity-toggle__input { width: 17px; height: 17px; margin: 0; }
.bh-toggle .unity-toggle__checkmark { width: 17px; height: 17px; border-radius: 4px; border-width: 1.5px; border-color: var(--bh-muted); background-color: transparent; background-image: none; margin: 0; }
.bh-toggle:checked .unity-toggle__checkmark { background-color: var(--bh-accent); border-color: var(--bh-accent); }

/* sent screen */
.bh-email { flex-direction: row; align-items: flex-start; }
.bh-email__field { flex-grow: 1; margin-right: 9px; }
.bh-email .bh-placeholder { top: 10px; }

/* footer */
.bh-foot { flex-direction: row; align-items: center; padding: 14px 22px 19px 22px; border-top-width: 1px; border-color: var(--bh-line); }
.bh-hints { flex-grow: 1; flex-shrink: 1; flex-direction: row; align-items: center; min-height: 40px; }
.bh-hint { font-size: 12.5px; color: var(--bh-muted); margin-right: 14px; }
.bh-status { font-size: 12.5px; color: var(--bh-muted); }
.bh-btn { padding: 10px 18px; border-radius: var(--bh-radius); border-width: 1px; border-color: transparent; font-size: 16px; margin-left: 12px; }
.bh-btn--ghost { color: var(--bh-muted); }
.bh-btn--ghost:hover { background-color: var(--bh-surface); color: var(--bh-text); }
.bh-btn--outline { border-color: var(--bh-line); color: var(--bh-text); margin-left: 0; }
.bh-btn--outline:hover { border-color: var(--bh-muted); }
.bh-btn--primary { background-color: var(--bh-accent); color: var(--bh-on-accent); }
.bh-btn--primary:hover { opacity: 0.92; }
.bh-btn:disabled { opacity: 0.45; }

/* background upload toast */
.bh-toast {
  -unity-font-definition: url("Fonts/Inter-Regular.ttf");
  position: absolute; right: 24px; bottom: 96px;
  flex-direction: row; align-items: center;
  padding: 11px 15px;
  background-color: var(--bh-ground);
  border-width: 1px; border-color: var(--bh-line); border-radius: var(--bh-radius);
  color: var(--bh-text);
}
.bh-toast__dot { width: 10px; height: 10px; border-radius: 5px; background-color: var(--bh-accent); margin-right: 12px; }
.bh-toast--done .bh-toast__dot { background-color: var(--bh-ok); }
.bh-toast--failed .bh-toast__dot { background-color: var(--bh-warn); }
.bh-toast__text { font-size: 14px; }
.bh-toast__sub { font-size: 12px; color: var(--bh-muted); }
